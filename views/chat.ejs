            <div class="setting-info" style="width: 100%;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                <span class="setting-name">Model Cache &amp; Initialization</span>
                <span class="status-badge-inline" id="modelCacheBadge">Checking...</span>
              </div>
              <span class="setting-desc" id="modelCacheStatusDesc">Status: Checking browser cache...</span>

              <!-- Download progress bar -->
              <div class="local-progress-wrap" id="localAiProgressWrap" hidden>
                <div class="local-progress-bar">
                  <div class="local-progress-fill" id="localAiProgressFill" style="width: 0%;"></div>
                </div>
                <div class="local-progress-meta">
                  <span class="local-progress-text" id="localAiProgressPercent">0%</span>
                  <span class="local-progress-info" id="localAiProgressText">Downloading model...</span>
                </div>
              </div>

              <!-- Diagnostics & Error Box (Phase 5) -->
              <div class="local-ai-diagnostic-box" id="localAiDiagnosticBox" style="display: none; margin-top: 0.75rem; margin-bottom: 0.5rem; padding: 0.65rem 0.85rem; border-radius: 8px; font-size: 0.82rem; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); color: var(--app-text-primary);">
                <div style="display: flex; align-items: center; gap: 0.4rem; font-weight: 600; color: #ef4444; margin-bottom: 0.25rem;">
                  <span id="localAiDiagnosticBadge" class="status-badge-inline" style="background: rgba(239, 68, 68, 0.2); color: #ef4444; font-size: 0.7rem; padding: 1px 6px;">Error</span>
                  <span id="localAiDiagnosticTitle">Diagnostic Error</span>
                </div>
                <div id="localAiDiagnosticMessage" style="line-height: 1.4; word-break: break-word;"></div>
                <div id="localAiDiagnosticDetails" style="font-family: var(--font-mono, monospace); font-size: 0.75rem; opacity: 0.8; margin-top: 0.35rem; padding: 0.35rem 0.5rem; background: rgba(0, 0, 0, 0.15); border-radius: 4px; word-break: break-all; display: none;"></div>
              </div>

              <!-- Action Buttons -->
              <div class="model-action-buttons">
                <button type="button" class="btn-primary-sm" id="downloadModelBtn">Download Model</button>
                <button type="button" class="btn-secondary-sm" id="testInferenceBtn" style="display: none;">Test Local AI</button>
                <button type="button" class="btn-danger-sm" id="deleteModelBtn" style="display: none;">Delete Local Model</button>
              </div>
            </div>
          </div>

          <!-- Persistent Storage Status -->
          <div class="setting-item">
            <div class="setting-info">
              <span class="setting-name">Browser Storage Persistence</span>
              <span class="setting-desc" id="storagePersistenceDesc">Protects downloaded AI models against automatic browser eviction.</span>
            </div>
            <span class="status-badge-inline status-online" id="storagePersistenceBadge">Checking...</span>
          </div>

          <!-- Dedicated Examination Offline Mode Toggle Row -->
          <div class="setting-item" id="settingsExamModeRow">
            <div class="setting-info">
              <span class="setting-name" style="display: flex; align-items: center; gap: 0.4rem;">
                <span>🎓</span> Dedicated Examination Mode
              </span>
              <span class="setting-desc">Enforces 100% on-device local WebLLM execution. Bypasses all Gemini API calls and cloud requests.</span>
            </div>
            <button type="button" class="btn-secondary-sm" id="settingsExamModeToggleBtn">
              <span id="settingsExamModeIcon">🔒</span> <span id="settingsExamModeLabel">Enable Exam Mode</span>
            </button>
          </div>

          <!-- Pre-Exam Zero-Internet Readiness Checker -->
          <div class="setting-item pre-exam-readiness-item" style="flex-direction: column; align-items: stretch; gap: 0.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
              <div>
                <span class="setting-name" style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.95rem;">
                  <span>📋</span> Pre-Exam Offline Readiness Checker
                </span>
                <span class="setting-desc">Verify that this device is 100% prepared for zero-internet examination use.</span>
              </div>
              <span class="status-badge-inline" id="examReadinessOverallBadge" style="background: rgba(245, 158, 11, 0.15); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.3);">Check Pending</span>
            </div>

            <!-- Readiness Checklist Cards -->
            <div class="exam-checklist-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 0.5rem; font-size: 0.8rem;">
              <div class="exam-check-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; margin-bottom: 2px;">1. Model Name &amp; Size</div>
                <div id="examCheckModelName" style="color: var(--text-muted, #64748b);">Qwen2.5-Coder 1.5B (~980 MB)</div>
              </div>

              <div class="exam-check-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; margin-bottom: 2px;">2. Model Download Status</div>
                <div id="examCheckDownloadStatus" style="color: var(--text-muted, #64748b);">Checking cache...</div>
              </div>

              <div class="exam-check-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; margin-bottom: 2px;">3. WebGPU Shader Init</div>
                <div id="examCheckShaderStatus" style="color: var(--text-muted, #64748b);">Not initialized</div>
              </div>

              <div class="exam-check-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; margin-bottom: 2px;">4. Persistent Storage</div>
                <div id="examCheckPersistenceStatus" style="color: var(--text-muted, #64748b);">Checking...</div>
              </div>

              <div class="exam-check-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; margin-bottom: 2px;">5. App Shell &amp; Worker</div>
                <div id="examCheckAssetsStatus" style="color: var(--text-muted, #64748b);">Checking...</div>
              </div>

              <div class="exam-check-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; margin-bottom: 2px;">6. Offline Generation Test</div>
                <div id="examCheckInferenceStatus" style="color: var(--text-muted, #64748b);">Not tested yet</div>
              </div>
            </div>

            <!-- Diagnostics log / Test output -->
            <div id="examTestProgressLog" style="display: none; padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.75rem; font-family: var(--font-mono, monospace); background: rgba(0,0,0,0.1); border: 1px solid var(--border-subtle, rgba(0,0,0,0.1)); line-height: 1.4; max-height: 120px; overflow-y: auto;">
            </div>

            <!-- Pre-Exam Actions -->
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem;">
              <button type="button" class="btn-primary-sm" id="testOfflineModeBtn">
                <span>⚡</span> Test Offline Mode
              </button>
              <button type="button" class="btn-secondary-sm" id="grantStoragePersistBtn">
                <span>🛡️</span> Grant Persistent Storage
              </button>
            </div>
          </div>

          <!-- Offline Image Generation Architecture (Part 6) -->
          <div class="setting-item">
            <div class="setting-info">
              <span class="setting-name">Offline Image Architecture</span>
              <span class="setting-desc">WebLLM is an LLM text engine. Offline diffusion (Web-SD) requires 4GB+ VRAM &amp; explicit ~2GB model download.</span>
            </div>
            <span class="status-badge-inline" id="offlineImageBadge" style="background: rgba(147, 51, 234, 0.15); color: #a855f7; border: 1px solid rgba(147, 51, 234, 0.3);">Web-SD Ready</span>
          </div>

          <!-- Image Generation Performance Mode (Phase 5) -->
          <div class="setting-item">
            <div class="setting-info">
              <span class="setting-name">Image Generation Mode</span>
              <span class="setting-desc">Fast Mode optimizes for low latency (512px preview, minimal thinking). Quality Mode renders 1K HD visuals.</span>
            </div>
            <select class="form-select form-select-sm" id="settingsImageModeSelect" aria-label="Default image generation mode" style="width: auto; min-width: 140px;">
              <option value="fast" selected>⚡ Fast Mode (512px)</option>
              <option value="quality">✨ Quality Mode (1K)</option>
            </select>
          </div>
        </div>

        <!-- ── OFFLINE PACKAGE MANAGER (Export & Import System) ── -->
        <div class="settings-card-group" id="offlinePackageManagerGroup">
          <div class="settings-group-header">
            <div class="settings-group-title">
              <span class="settings-icon">📦</span>
              <div>
                <h4 class="settings-group-heading">Offline Package Manager (Export &amp; Import)</h4>
                <p class="settings-group-sub">Portable, zero-internet offline packages containing model weights, Data Structures syllabus, and WebLLM runtime.</p>
              </div>
            </div>
          </div>

          <!-- Device & Mobile Environment Compatibility Card -->
          <div class="setting-item" style="flex-direction: column; align-items: stretch; gap: 0.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
              <div>
                <span class="setting-name" style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.95rem;">
                  <span id="pkgDeviceIcon">💻</span> Device Hardware &amp; Compatibility
                </span>
                <span class="setting-desc" id="pkgDeviceDesc">Evaluating platform, memory, and WebGPU capabilities...</span>
              </div>
              <span class="status-badge-inline" id="pkgDeviceBadge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">Detecting...</span>
            </div>

            <!-- Mobile Safety Alert Banner (shown when mobile / low memory is detected) -->
            <div id="pkgMobileAlertBanner" style="display: none; padding: 0.6rem 0.8rem; border-radius: 6px; font-size: 0.8rem; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); color: var(--app-text-primary);">
              <div style="font-weight: 600; color: #d97706; display: flex; align-items: center; gap: 0.4rem; margin-bottom: 2px;">
                <span>📱</span> Mobile &amp; Android Device Optimization
              </div>
              <div id="pkgMobileAlertMessage" style="font-size: 0.76rem; line-height: 1.4; color: var(--text-muted, #64748b);">
                Mobile browser detected. Qwen2.5-Coder 0.5B (~390 MB) is recommended to avoid mobile OS memory terminations. Keep this tab in foreground during export/import.
              </div>
            </div>

            <!-- Package Configuration Grid -->
            <div class="package-meta-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem; font-size: 0.8rem;">
              <div class="pkg-meta-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; color: var(--text-muted, #64748b);">Selected Model</div>
                <div id="pkgMetaModelName" style="font-weight: 600; margin-top: 2px;">Qwen2.5-Coder 1.5B</div>
              </div>
              <div class="pkg-meta-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; color: var(--text-muted, #64748b);">Package Format</div>
                <div style="font-weight: 600; margin-top: 2px;">StudyMate Archive v1.0</div>
              </div>
              <div class="pkg-meta-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; color: var(--text-muted, #64748b);">DS Knowledge Base</div>
                <div style="font-weight: 600; margin-top: 2px; color: #10b981;">9 Syllabus Units Included</div>
              </div>
              <div class="pkg-meta-card" style="padding: 0.5rem 0.65rem; border-radius: 6px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-subtle, rgba(0,0,0,0.08));">
                <div style="font-weight: 600; color: var(--text-muted, #64748b);">Integrity Protection</div>
                <div style="font-weight: 600; margin-top: 2px; color: #4f46e5;">SHA-256 Verified</div>
              </div>
            </div>

            <!-- Export / Import Progress Bar -->
            <div class="local-progress-wrap" id="packageProgressWrap" hidden>
              <div class="local-progress-bar">
                <div class="local-progress-fill" id="packageProgressFill" style="width: 0%;"></div>
              </div>
              <div class="local-progress-meta">
                <span class="local-progress-text" id="packageProgressPercent">0%</span>
                <span class="local-progress-info" id="packageProgressText">Preparing package...</span>
              </div>
            </div>

            <!-- Package Diagnostics & Output Log Display -->
            <div id="packageInfoDisplay" style="display: none; padding: 0.65rem 0.85rem; border-radius: 8px; font-size: 0.8rem; background: rgba(0,0,0,0.05); border: 1px solid var(--border-subtle, rgba(0,0,0,0.1)); line-height: 1.45; max-height: 200px; overflow-y: auto;">
            </div>

            <!-- Actions Row -->
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem;">
              <input type="file" id="offlinePackageFileInput" accept=".zip" style="display: none;" aria-label="Select Offline Package ZIP">
              <button type="button" class="btn-primary-sm" id="exportPackageBtn">
                <span>📦</span> Export Complete Offline Package
              </button>
              <button type="button" class="btn-secondary-sm" id="importPackageBtn">
                <span>📥</span> Import Offline Package (.zip)
              </button>
              <button type="button" class="btn-secondary-sm" id="verifyPackageBtn">
                <span>🔍</span> Verify Package
              </button>
              <button type="button" class="btn-secondary-sm" id="comprehensiveReadinessBtn">
                <span>⚡</span> 9-Step Offline Readiness Test
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-modal btn-primary" id="settingsDoneBtn">Done</button>
      </div>
    </div>
  </div>

  <!-- Delete Conversation Modal -->
  <div class="modal-backdrop" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle" hidden>
    <div class="modal-card">
      <div class="modal-icon-warn" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
          <path d="M10 11v6"></path>
          <path d="M14 11v6"></path>
          <path d="M9 6V4h6v2"></path>
        </svg>
      </div>
      <h3 class="modal-title" id="deleteModalTitle">Delete Conversation?</h3>
      <p class="modal-desc" id="deleteModalDesc">This conversation and its message history will be permanently removed from this browser.</p>
      <div class="modal-actions">
        <button type="button" class="btn-modal btn-cancel" id="deleteModalCancel">Cancel</button>
        <button type="button" class="btn-modal btn-danger" id="deleteModalConfirm">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast notifications container -->
  <div class="toast-container" id="toastContainer" aria-live="polite"></div>

  <!-- Application Logic -->
  <script src="/js/jszip.min.js"></script>
  <script src="/js/ds-knowledge-engine.js"></script>
  <script src="/js/ds-complete-data.js"></script>
  <script src="/js/ds-learning-module.js"></script>
  <script src="/js/local-ai-detector.js"></script>
  <script src="/js/offline-package-manager.js"></script>
  <script src="/js/chat.js"></script>

</body>
</html>
