<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="StudyMate AI — Modern generative AI study assistant and academic companion powered by Google Gemini.">
  <title><%= pageTitle ? pageTitle + ' | StudyMate AI' : 'StudyMate AI — Your Intelligent Academic Companion' %></title>

  <!-- Google Fonts: Outfit for titles, Plus Jakarta Sans for body, JetBrains Mono for code -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Application Stylesheets -->
  <link rel="stylesheet" href="/css/chat.css">

  <!-- Progressive Web App Meta & Manifest -->
  <meta name="theme-color" content="#4f46e5">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="StudyMate AI">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">

  <!-- Client-side Configuration -->
  <script id="app-config" type="application/json">
    <%- JSON.stringify({
      apiKeyConfigured: typeof apiKeyConfigured !== 'undefined' ? apiKeyConfigured : false,
      geminiModel: (typeof geminiModel !== 'undefined' && geminiModel) ? geminiModel : 'gemini-3.5-flash-lite',
      chatApiUrl: '/api/chat',
      toolsApiUrl: '/api/tools'
    }) %>
  </script>
  <script>
    try {
      window.APP_CONFIG = JSON.parse(document.getElementById('app-config').textContent || '{}');
    } catch (e) {
      window.APP_CONFIG = {
        apiKeyConfigured: false,
        geminiModel: 'gemini-3.5-flash-lite',
        chatApiUrl: '/api/chat',
        toolsApiUrl: '/api/tools'
      };
    }
  </script>
  <!-- Immediate Theme & Global Surface Opacity Initialization (Prevents flash) -->
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('studymate_theme_v1');
        if (savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        var savedOpacity = localStorage.getItem('studymate_surface_opacity');
        if (savedOpacity !== null) {
          var num = parseInt(savedOpacity, 10);
          if (!isNaN(num) && num >= 20 && num <= 100) {
            var dec = (num / 100).toFixed(2);
            document.documentElement.style.setProperty('--app-surface-opacity', dec);
            document.documentElement.style.setProperty('--surface-opacity', dec);
          }
        }
        var savedSidebar = localStorage.getItem('studymate_sidebar_collapsed');
        if (savedSidebar === 'true' && window.innerWidth > 768) {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="app-body" data-theme="dark">

  <!-- ═══════════════════════════════════════════════════════
       1. LEFT SIDEBAR — StudyMate AI Navigation & History
  ═══════════════════════════════════════════════════════════ -->
  <aside class="sidebar" id="sidebar" role="complementary" aria-label="StudyMate AI navigation and conversation history">

    <!-- Brand Header -->
    <div class="sidebar-header">
      <div class="brand">
        <div class="brand-icon" aria-hidden="true" title="StudyMate AI">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-name">StudyMate AI</span>
          <span class="brand-sub">Academic Companion</span>
        </div>
      </div>
      <!-- Close button on mobile/tablet -->
      <button class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close sidebar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Primary Action: New Chat -->
    <div class="sidebar-action-wrap">
      <button class="new-chat-btn" id="newChatBtn" aria-label="Start a new conversation" title="New Chat (Ctrl+K)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>New Chat</span>
      </button>
    </div>

    <!-- Main Navigation Items -->
    <div class="sidebar-nav-section">
      <p class="sidebar-label">Navigation</p>
      <nav class="nav-menu" aria-label="Primary navigation">
        <a href="/" class="nav-item active" id="navHome" title="Home">
          <span class="nav-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </span>
          <span class="nav-text">Home</span>
        </a>
        <button type="button" class="nav-item" id="navDSCompleteAnswers" title="DS Complete Answers (Interactive Offline Learning Center)">
          <span class="nav-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path><polyline points="10 8 13 11 10 14"></polyline></svg>
          </span>
          <span class="nav-text">DS Complete Answers</span>
        </button>
        <button type="button" class="nav-item" id="navSubjectNotes" title="Subject Notes (Document Reader & Revision Notes)">
          <span class="nav-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </span>
          <span class="nav-text">Subject Notes</span>
        </button>
        <button type="button" class="nav-item" id="navPracticeQuiz" title="Practice & Quiz Generator">
          <span class="nav-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </span>
          <span class="nav-text">Practice &amp; Quiz</span>
        </button>
        <button type="button" class="nav-item" id="navStudyPlanner" title="Study Planner & Exam Schedules">
          <span class="nav-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </span>
          <span class="nav-text">Study Planner</span>
        </button>
        <button type="button" class="nav-item" id="navSavedItems" title="Saved Notes & Responses">
          <span class="nav-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          </span>
          <span class="nav-text">Saved Items</span>
        </button>
        <button type="button" class="nav-item" id="navSettings" title="Preferences & Diagnostics">
          <span class="nav-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </span>
          <span class="nav-text">Settings</span>
        </button>
      </nav>
    </div>

    <!-- AI Study Tools Quick Triggers (Keeps verified IDs for test suites) -->
    <div class="sidebar-tools-section">
      <div class="sidebar-section-header">
        <p class="sidebar-label">AI Study Tools</p>
        <div class="sidebar-tools-header-actions">
          <button type="button" class="topbar-tools-btn sidebar-tools-btn" id="openToolsBtn" title="Open AI Study Tools Modal" aria-label="Open AI Study Tools">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
            <span>Tools</span>
          </button>
          <button type="button" class="open-all-tools-link" id="sidebarAllToolsLink">All</button>
        </div>
      </div>
      <div class="tools-grid">
        <button class="tool-btn" data-tool="explain" id="sidebarToolExplain" title="Concept Explainer">
          <span class="tool-icon">💡</span>
          <span class="tool-text">Explainer</span>
        </button>
        <button class="tool-btn" data-tool="programming" id="sidebarToolProgramming" title="Programming Assistant">
          <span class="tool-icon">💻</span>
          <span class="tool-text">Code Help</span>
        </button>
        <button class="tool-btn" data-tool="summarize" id="sidebarToolSummarize" title="Notes Summarizer">
          <span class="tool-icon">📝</span>
          <span class="tool-text">Summarizer</span>
        </button>
        <button class="tool-btn" data-tool="quiz" id="sidebarToolQuiz" title="AI Quiz Generator">
          <span class="tool-icon">🎯</span>
          <span class="tool-text">AI Quiz</span>
        </button>
      </div>
    </div>

    <!-- Chat History List -->
    <div class="sidebar-section convo-section">
      <div class="sidebar-section-header">
        <p class="sidebar-label">Chat History</p>
        <button type="button" class="sidebar-clear-all-btn" id="sidebarClearAllBtn" title="Clear all conversation history" aria-label="Clear all conversations">Clear All</button>
      </div>

      <!-- Compact Search Bar in Chat History -->
      <div class="sidebar-search-wrap" role="search" title="Search chats, topics or subjects">
        <span class="sidebar-search-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </span>
        <input
          type="search"
          id="chatSearchInput"
          class="sidebar-search-input"
          placeholder="Search chats or topics…"
          aria-label="Search chats, topics or subjects"
        >
      </div>

      <nav class="convo-list" id="convoList" aria-label="Recent conversations">
        <p class="convo-empty" id="convoEmpty">No conversations yet.<br>Start your first session above!</p>
      </nav>
    </div>

    <!-- Sidebar Footer: Status & Model -->
    <div class="sidebar-footer">
      <div class="api-status-pill" id="apiStatusPill" title="Connected AI Engine">
        <span class="status-dot <%- apiKeyConfigured ? 'dot-green' : 'dot-amber' %>"></span>
        <span class="status-text">
          <%- apiKeyConfigured ? 'Gemini AI Connected' : 'API Key Missing' %>
        </span>
      </div>
    </div>
  </aside>

  <!-- Sidebar Overlay for Mobile/Tablet -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- ═══════════════════════════════════════════════════════
       2. MAIN APPLICATION WORKSPACE
  ═══════════════════════════════════════════════════════════ -->
  <div class="app-workspace">

    <!-- ── Center Chat Panel ── -->
    <div class="chat-layout">

      <!-- Top Navigation Bar -->
      <header class="chat-topbar">
        <div class="topbar-left">
          <button class="topbar-menu-btn" id="sidebarOpenBtn" aria-label="Toggle navigation sidebar" aria-expanded="true" title="Toggle Navigation Sidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
          <div class="topbar-title-wrap">
            <h1 class="topbar-title" id="topbarTitle">StudyMate AI</h1>
            <span class="topbar-subtitle">Academic Assistant</span>
          </div>
        </div>

        <div class="topbar-actions topbar-right">
          <!-- Compact AI engine status indicator (Gemini / Local AI / Offline) -->
          <div class="offline-badge-pill" id="offlineIndicatorBadge" role="status" aria-live="polite" hidden title="You are currently offline. Gemini AI features require an internet connection.">
            <span class="offline-dot"></span>
            <span class="offline-pill-text">Offline</span>
          </div>

          <button type="button" class="engine-indicator-pill" id="engineIndicatorPill" role="status" title="Active AI Engine — Click to configure in Settings">
            <span class="engine-indicator-dot dot-green" id="engineIndicatorDot"></span>
            <span class="engine-indicator-text" id="engineIndicatorText">Gemini AI</span>
          </button>

          <!-- Dedicated Examination Offline Mode Toggle Button -->
          <button type="button" class="exam-mode-toggle-btn" id="examModeToggleBtn" title="Toggle Dedicated Examination Offline Mode" aria-pressed="false">
            <span class="exam-mode-icon">🎓</span>
            <span class="exam-mode-label">Exam Mode</span>
          </button>

          <!-- Compact Transparency Controller Button & Popover -->
          <div class="transparency-ctrl-wrapper" id="transparencyCtrlWrapper">
            <button type="button" class="icon-btn transparency-toggle-btn" id="topbarTransparencyBtn" title="Interface Transparency & Visual Accessibility (20% – 100%)" aria-label="Adjust surface transparency" aria-haspopup="true" aria-expanded="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a10 10 0 0 0 0 20v-20z"></path>
              </svg>
            </button>
            <div class="transparency-popover" id="topbarTransparencyPopover" role="dialog" aria-label="Adjust surface transparency" hidden>
              <div class="transparency-popover-header">
                <span class="transparency-popover-title">Transparency</span>
                <span class="transparency-popover-val" id="topbarTransparencyVal">100%</span>
              </div>
              <div class="transparency-popover-slider-wrap">
                <input
                  type="range"
                  id="topbarTransparencySlider"
                  class="surface-opacity-slider topbar-opacity-slider"
                  min="20"
                  max="100"
                  value="100"
                  step="1"
                  aria-label="Interface surface transparency percentage"
                >
                <div class="transparency-popover-labels">
                  <span>20% (Glass)</span>
                  <span>100% (Solid)</span>
                </div>
              </div>
              <div class="transparency-popover-actions">
                <button type="button" class="btn-popover-reset" id="topbarResetOpacityBtn">Reset to Default</button>
              </div>
            </div>
          </div>

          <!-- Theme Toggle Button -->
          <button type="button" class="icon-btn theme-toggle-btn" id="themeToggleBtn" title="Toggle Light/Dark Theme" aria-label="Toggle Theme">
            <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <!-- Notification Icon & Dropdown -->
          <div class="notif-wrapper">
            <button type="button" class="icon-btn notif-btn" id="notifBtn" title="Study Notifications" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              <span class="notif-badge" id="notifBadge" aria-hidden="true"></span>
            </button>
            <div class="notif-dropdown" id="notifDropdown" hidden>
              <div class="notif-header">
                <h4>Study Alerts</h4>
                <button type="button" class="notif-dismiss-btn" id="notifClearBtn">Dismiss</button>
              </div>
              <ul class="notif-list">
                <li class="notif-item unread">
                  <span class="notif-emoji">💡</span>
                  <div class="notif-info">
                    <p class="notif-msg">Welcome to <strong>StudyMate AI</strong>! Ask questions or launch practice quizzes.</p>
                    <span class="notif-time">Just now</span>
                  </div>
                </li>
                <li class="notif-item">
                  <span class="notif-emoji">🎯</span>
                  <div class="notif-info">
                    <p class="notif-msg">Gemini 3.5 Flash-Lite active with fast responses.</p>
                    <span class="notif-time">Connected</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>

          <!-- Student profile avatar with dropdown -->
          <div class="profile-wrapper">
            <button type="button" class="profile-chip" id="profileChip" title="Active Student Session — Click for options" aria-haspopup="true" aria-expanded="false" aria-label="Student Profile Menu">
              <div class="profile-avatar">S</div>
              <div class="profile-meta">
                <span class="profile-name">Student</span>
                <span class="profile-status"><span class="status-dot dot-green"></span>Active</span>
              </div>
              <svg class="profile-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="profile-dropdown" id="profileDropdown" hidden>
              <div class="profile-dropdown-header">
                <div class="profile-avatar large">S</div>
                <div class="profile-dropdown-info">
                  <span class="profile-dropdown-name">Student Scholar</span>
                  <span class="profile-dropdown-role"><span class="status-dot dot-green"></span> Active Session</span>
                </div>
              </div>
              <div class="profile-dropdown-menu">
                <button type="button" class="profile-menu-item" id="profileSettingsBtn">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                  <span>Preferences &amp; Diagnostics</span>
                </button>
                <button type="button" class="profile-menu-item" id="profileSavedBtn">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                  <span>Saved Notes &amp; Responses</span>
                </button>
                <button type="button" class="profile-menu-item" id="profilePlannerBtn">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <span>Study Planner</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- ── Workspace Options Subbar (Relocated Study Mode & Action Controls) ── -->
      <div class="workspace-subbar" id="workspaceSubbar" role="toolbar" aria-label="Chat workspace options">
        <div class="workspace-subbar-left">
          <!-- Learning Mode Selector -->
          <div class="mode-selector-wrapper" title="Change Study Mode Guidance">
            <span class="mode-badge-label">Study Mode:</span>
            <select class="mode-select" id="studyModeSelect" aria-label="Select study mode">
              <option value="standard" selected>🎓 Standard Academic</option>
