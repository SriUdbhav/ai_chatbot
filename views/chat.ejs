              <div class="doc-progress-fill" id="docProgressFill"></div>
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div class="doc-alert-box alert-error" id="docErrorBanner" hidden role="alert">
            <div class="alert-icon">⚠️</div>
            <div class="alert-content">
              <h4 class="alert-title" id="docErrorTitle">Upload Failed</h4>
              <p class="alert-desc" id="docErrorMessage">Please upload a valid PDF, DOCX, or TXT file under 10 MB.</p>
            </div>
            <button type="button" class="alert-dismiss-btn" id="docErrorDismissBtn" aria-label="Dismiss error">✕</button>
          </div>

          <!-- Active Document Metadata Card -->
          <div class="doc-meta-card" id="docMetaCard" hidden>
            <div class="meta-card-header">
              <div class="meta-card-type-icon" id="docTypeIcon">📄</div>
              <div class="meta-card-info">
                <h4 class="meta-card-filename" id="docMetaFilename">document.pdf</h4>
                <div class="meta-badges-row">
                  <span class="meta-pill" id="docMetaType">PDF</span>
                  <span class="meta-pill" id="docMetaSize">1.2 MB</span>
                  <span class="meta-pill" id="docMetaPages">1 Page</span>
                  <span class="meta-pill" id="docMetaWords">0 Words</span>
                </div>
              </div>
              <button type="button" class="btn-remove-doc" id="docRemoveBtn" title="Remove Document" aria-label="Remove document">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                <span>Remove</span>
              </button>
            </div>

            <!-- Workflow Quick Next Actions -->
            <div class="meta-card-actions">
              <button type="button" class="btn-doc-action btn-doc-primary" id="docQuickNotesBtn">
                <span>📝 Generate 9-Part Study Notes</span>
              </button>
              <button type="button" class="btn-doc-action btn-doc-secondary" id="docQuickChatBtn">
                <span>💬 Chat with this Document</span>
              </button>
              <button type="button" class="btn-doc-action btn-doc-outline" id="docQuickTextBtn">
                <span>👁️ View Extracted Text</span>
              </button>
            </div>
          </div>

        </div><!-- /paneDocUpload -->

        <!-- ── PANE 2: SUMMARIZED STUDY NOTES (9 SECTIONS) ── -->
        <div class="doc-pane" id="paneDocNotes" role="tabpanel" aria-labelledby="tabDocNotes" hidden>
          
          <!-- Notes Controls Toolbar -->
          <div class="doc-notes-toolbar">
            <div class="notes-depth-wrap">
              <label for="docNotesDepth" class="toolbar-label">Detail Level:</label>
              <select id="docNotesDepth" class="form-select doc-select-sm">
                <option value="short">Short (~300w High-Yield Summary)</option>
                <option value="medium" selected>Medium (~750w Academic Standard)</option>
                <option value="detailed">Detailed (~1,400w Comprehensive Breakdown)</option>
              </select>
            </div>

            <div class="notes-actions-group">
              <button type="button" class="btn-toolbar btn-primary-sm" id="docGenerateNotesBtn">
                <span class="btn-icon">⚡</span>
                <span id="docGenerateNotesText">Generate Notes</span>
              </button>
              <button type="button" class="btn-toolbar" id="docCopyNotesBtn" title="Copy Notes to Clipboard">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
              <button type="button" class="btn-toolbar" id="docDownloadNotesBtn" title="Download Notes as Markdown (.md)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Download .md</span>
              </button>
              <button type="button" class="btn-toolbar btn-outline-indigo" id="docExportNotesBtn" title="Send Notes into Active Chat Workspace">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M10 14L21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                <span>Export to Chat</span>
              </button>
            </div>
          </div>

          <!-- Notes Body Container -->
          <div class="doc-notes-body" id="docNotesBody">
            <!-- Empty Placeholder -->
            <div class="doc-empty-state" id="docNotesEmpty">
              <div class="empty-icon">📝</div>
              <h4>No Study Notes Generated Yet</h4>
              <p>Upload a PDF, Word document, or text file, select your desired depth above, and click <strong>Generate Notes</strong>.</p>
              <button type="button" class="btn-primary-sm" id="docEmptyUploadBtn">Go to Upload</button>
            </div>

            <!-- Loading Skeleton -->
            <div class="doc-loading-state" id="docNotesLoading" hidden>
              <div class="spinner-pulse"></div>
              <p class="loading-status-text" id="docNotesLoadingText">Analyzing document structure and synthesizing 9-part notes...</p>
              <span class="loading-sub">Powered by Gemini AI Engine</span>
            </div>

            <!-- Rendered 9-Section Notes Content -->
            <div class="doc-notes-rendered markdown-content" id="docNotesRendered" hidden></div>
          </div>

        </div><!-- /paneDocNotes -->

        <!-- ── PANE 3: CHAT WITH DOCUMENT ── -->
        <div class="doc-pane" id="paneDocChat" role="tabpanel" aria-labelledby="tabDocChat" hidden>
          
          <!-- Subheader / Document Context Bar -->
          <div class="doc-chat-subbar">
            <div class="chat-doc-info">
              <span class="chat-doc-pill" id="docChatDocPill">📄 No document active</span>
              <span class="chat-doc-hint">AI answers cite sections from this document</span>
            </div>
            <button type="button" class="btn-secondary-sm" id="docChatClearBtn" title="Clear Document Q&A History">Clear Chat</button>
          </div>

          <!-- Suggested Prompt Chips -->
          <div class="doc-chat-chips" id="docChatChips">
            <button type="button" class="doc-chip" data-query="Explain this topic in simple words.">💡 Explain in simple words</button>
            <button type="button" class="doc-chip" data-query="Summarize the core concepts and takeaways.">📋 Core takeaways</button>
            <button type="button" class="doc-chip" data-query="What are the important revision and exam questions?">❓ Likely exam questions</button>
            <button type="button" class="doc-chip" data-query="Explain the formulas and equations with examples.">📐 Formulas &amp; equations</button>
            <button type="button" class="doc-chip" data-query="Compare the two most important concepts explained in this document.">⚖️ Compare concepts</button>
          </div>

          <!-- Chat Messages Area -->
          <div class="doc-chat-messages" id="docChatMessages" role="log" aria-live="polite">
            <div class="doc-chat-msg doc-chat-msg-ai">
              <div class="doc-msg-avatar">🤖</div>
              <div class="doc-msg-bubble">
                <div class="doc-msg-source-tag">Source: Document Assistant</div>
                <p>Hello! I am ready to answer your questions based on your uploaded document. Ask for simple explanations, formula breakdowns, chapter summaries, or likely exam questions.</p>
              </div>
            </div>
          </div>

          <!-- Chat Composer -->
          <form class="doc-chat-composer" id="docChatForm">
            <textarea
              class="doc-chat-input"
              id="docChatInput"
              placeholder="Ask a question about this document… (Enter sends, Shift+Enter for newline)"
              rows="2"
              maxlength="2000"
              aria-label="Ask a question about this document"
            ></textarea>
            <div class="doc-chat-composer-controls">
              <span class="doc-input-count" id="docChatInputCount">0 / 2,000</span>
              <button type="submit" class="btn-primary-sm doc-chat-send-btn" id="docChatSendBtn" disabled>
                <span>Ask AI</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </div>
          </form>

        </div><!-- /paneDocChat -->

        <!-- ── PANE 4: RAW EXTRACTED TEXT VIEWER ── -->
        <div class="doc-pane" id="paneDocText" role="tabpanel" aria-labelledby="tabDocText" hidden>
          <div class="doc-text-toolbar">
            <div class="text-search-wrap">
              <input type="search" id="docTextSearchInput" class="form-input text-search-input" placeholder="Search within extracted text…">
            </div>
            <div class="text-stats-wrap">
              <span class="text-stat-item" id="docTextStats">0 words • 0 chars</span>
              <button type="button" class="btn-toolbar" id="docCopyRawTextBtn" title="Copy Raw Text">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy Text</span>
              </button>
            </div>
          </div>

          <div class="doc-raw-text-view" id="docRawTextView">
            <pre class="doc-raw-pre" id="docRawPre">No document text available. Please upload a PDF, DOCX, or TXT document first.</pre>
          </div>
        </div><!-- /paneDocText -->

      </div><!-- /doc-content-wrapper -->

    </div><!-- /doc-studio-card -->
  </div><!-- /docStudioModal -->

  <!-- ═══════════════════════════════════════════════════════
       5. FEATURE MODALS: Study Planner, Saved Items, Settings
  ═══════════════════════════════════════════════════════════ -->

  <!-- Study Planner Modal -->
  <div class="modal-backdrop" id="plannerModal" role="dialog" aria-modal="true" aria-labelledby="plannerModalTitle" hidden>
    <div class="modal-card wide-modal-card">
      <div class="modal-header-simple">
        <div class="modal-title-with-icon">
          <span class="modal-badge-icon">📅</span>
          <div>
            <h3 class="modal-title" id="plannerModalTitle">AI Study Planner</h3>
            <p class="modal-desc">Generate an optimized study schedule for your upcoming exams or topics.</p>
          </div>
        </div>
        <button type="button" class="modal-close-x" id="plannerCloseBtn" aria-label="Close study planner">✕</button>
      </div>

      <div class="planner-body">
        <div class="form-row">
          <div class="form-group flex-2">
            <label for="plannerSubject">Subject or Exam</label>
            <input type="text" id="plannerSubject" class="form-input" placeholder="e.g. Data Structures Midterm, Calculus II Final...">
          </div>
          <div class="form-group flex-1">
            <label for="plannerDays">Timeframe</label>
            <select id="plannerDays" class="form-select">
              <option value="3">3-Day Sprint</option>
              <option value="7" selected>7-Day Schedule</option>
              <option value="14">2-Week Plan</option>
              <option value="30">1-Month Roadmap</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="plannerHours">Available Study Hours per Day</label>
          <select id="plannerHours" class="form-select">
            <option value="1-2">1–2 Hours (Light review)</option>
            <option value="2-4" selected>2–4 Hours (Standard)</option>
            <option value="4+">4+ Hours (Intensive prep)</option>
          </select>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-modal btn-cancel" id="plannerCancelBtn">Close</button>
        <button type="button" class="btn-modal btn-primary" id="plannerGenerateBtn">Create Plan in Chat</button>
      </div>
    </div>
  </div>

  <!-- Saved Items Modal -->
  <div class="modal-backdrop" id="savedItemsModal" role="dialog" aria-modal="true" aria-labelledby="savedModalTitle" hidden>
    <div class="modal-card">
      <div class="modal-header-simple">
        <div class="modal-title-with-icon">
          <span class="modal-badge-icon">🔖</span>
          <div>
            <h3 class="modal-title" id="savedModalTitle">Saved Items &amp; Notes</h3>
            <p class="modal-desc">Access bookmarked solutions and study snippets stored in this browser.</p>
          </div>
        </div>
        <button type="button" class="modal-close-x" id="savedCloseBtn" aria-label="Close saved items">✕</button>
      </div>
      <div class="saved-items-list" id="savedItemsList">
        <p class="convo-empty">No bookmarked messages yet.<br>Click the bookmark icon on any AI response to save key explanations here!</p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-modal btn-cancel" id="savedDismissBtn">Close</button>
      </div>
    </div>
  </div>

  <!-- Settings Modal -->
  <div class="modal-backdrop" id="settingsModal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle" hidden>
    <div class="modal-card">
      <div class="modal-header-simple">
        <div class="modal-title-with-icon">
          <span class="modal-badge-icon">⚙️</span>
          <div>
            <h3 class="modal-title" id="settingsModalTitle">Preferences &amp; Diagnostics</h3>
            <p class="modal-desc">Customize your study environment and check backend AI status.</p>
          </div>
        </div>
        <button type="button" class="modal-close-x" id="settingsCloseBtn" aria-label="Close settings">✕</button>
      </div>

      <div class="settings-body">
        <div class="setting-item">
          <div class="setting-info">
            <span class="setting-name">Connected AI Model</span>
            <span class="setting-desc" id="settingsModelName"><%= geminiModel || 'gemini-3.5-flash-lite' %></span>
          </div>
          <span class="status-badge-inline <%- apiKeyConfigured ? 'status-online' : 'status-offline' %>">
            <%- apiKeyConfigured ? 'Online' : 'Missing Key' %>
          </span>
        </div>

        <div class="setting-item">
          <div class="setting-info">
            <span class="setting-name">Storage Mechanism</span>
            <span class="setting-desc">Local client storage (browser localStorage)</span>
          </div>
          <button type="button" class="btn-secondary-sm" id="clearAllHistoryBtn">Clear All History</button>
        </div>

        <div class="setting-item">
          <div class="setting-info">
            <span class="setting-name">Speech Dictation</span>
            <span class="setting-desc">Browser SpeechRecognition Web API</span>
          </div>
          <span class="status-badge-inline status-online">Supported</span>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-modal btn-primary" id="settingsDoneBtn">Done</button>
      </div>
    </div>
  </div>

  <!-- Delete Conversation Modal -->
  <div class="modal-backdrop" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle" hidden>
    <div class="modal-card">
      <div class="modal-icon-warn" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
          <path d="M10 11v6"></path>
          <path d="M14 11v6"></path>
          <path d="M9 6V4h6v2"></path>
        </svg>
      </div>
      <h3 class="modal-title" id="deleteModalTitle">Delete Conversation?</h3>
      <p class="modal-desc" id="deleteModalDesc">This conversation and its message history will be permanently removed from this browser.</p>
      <div class="modal-actions">
        <button type="button" class="btn-modal btn-cancel" id="deleteModalCancel">Cancel</button>
        <button type="button" class="btn-modal btn-danger" id="deleteModalConfirm">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast notifications container -->
  <div class="toast-container" id="toastContainer" aria-live="polite"></div>

  <!-- Application Logic -->
  <script src="/js/chat.js"></script>

</body>
</html>
