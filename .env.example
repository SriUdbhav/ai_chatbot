# ==============================================================
# AI Study Assistant — Environment Configuration Template
# ==============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file. It is protected by .gitignore.

# Port the Express server will listen on
PORT=3000

# Google Gemini API key
# Obtain yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Override the Gemini model. Defaults to gemini-3.5-flash-lite.
# Other supported options: gemini-2.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite
