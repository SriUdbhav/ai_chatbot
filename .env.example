# ==============================================================
# StudyMate AI — Environment Configuration Template
# ==============================================================
# For local development: copy this file to .env and fill in real values.
# For Render deployment: configure these keys in Render Dashboard under Environment.
# NEVER commit the actual .env file. It is protected by .gitignore.

# Node Environment ('production' on Render)
NODE_ENV=production

# Server Port (Render sets this dynamically, defaults to 3000 locally)
PORT=3000

# Google Gemini API Key
# Obtain yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Override the Gemini text model. Defaults to gemini-3.5-flash-lite.
# Options: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# (Optional) Override the Gemini image generation model.
# Options: gemini-3.1-flash-lite-image (Fast Mode), gemini-3.1-flash-image (Quality Mode)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# (Optional) Trust reverse proxy headers (Render, Railway, Heroku). Defaults to true in production.
TRUST_PROXY=true
